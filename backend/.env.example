# ============================================================================
# RuralRefLink - backend environment variables
#
# Copy this file to ".env" and adjust the values, OR simply run
# "setup_database.bat" once (recommended) - it creates the PostgreSQL role +
# database and writes backend\.env for you.
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL (recommended). Requires running "setup_database.bat" once, or
# creating the role/database manually (see README > Database).
DATABASE_URL=postgresql+psycopg://ruralref:ruralref@localhost:5432/ruralref

# SQLite - zero setup. Uncomment this line (and comment the one above) to run
# without PostgreSQL. The file and all demo data are created automatically.
# DATABASE_URL=sqlite:///./ruralref.db

# --- Security ---------------------------------------------------------------
JWT_SECRET=ruralreflink_super_secret_jwt_signing_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Optional Supabase credentials (not used by the FastAPI backend) --------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
